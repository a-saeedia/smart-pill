# smart-pill — environment (all optional)

# Where smart-pill keeps its memory store (default: ~/.smart-pill)
SMART_PILL_HOME=C:\Users\user\.smart-pill

# Escalation model for pill_route (OpenRouter chat/completions)
SMART_PILL_ROUTE_MODEL=anthropic/claude-3.7-sonnet

# OpenRouter key for pill_route / LLM digest (optional; advisory mode when absent)
OPENROUTER_API_KEY=

# LLM digest model used by pill_digest when task=summarize (optional)
SMART_PILL_DIGEST_MODEL=anthropic/claude-3.5-haiku