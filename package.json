{
  "name": "smart-pill",
  "version": "0.5.0",
  "description": "MCP server that smarts up free opencode models: context digesting, persistent memory, plan-first discipline, self-review, token ledger, big-model escalation.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "model:fetch": "node scripts/bootstrap-model.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "prettier --check src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "prettier": "^3.0.0"
  }
}
